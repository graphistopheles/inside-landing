# Node.js
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json # If you use npm and commit package-lock.json, remove this line
yarn.lock         # If you use yarn and commit yarn.lock, remove this line
pnpm-lock.yaml    # If you use pnpm and commit pnpm-lock.yaml, remove this line

# Vite
dist/
.vite/
# If your build output directory is different and at the root, add it here.
# For example, if vite.config.js has build.outDir = 'build', add /build/

# Environment variables
.env
.env.*
!.env.example
!.env.production.local # Example: if you want to track a specific local env for production

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
logs
*.log.*

# Coverage output
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
*~
*.bak
*.swo
*.swp

# Local user files
.user
.userprefs

# Optional: Sass cache
.sass-cache/